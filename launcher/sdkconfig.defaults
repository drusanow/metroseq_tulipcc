# Launcher on top of components/tulip_hal/sdkconfig.tulip.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../components/tulip_hal/partitions_tulip.csv"

# Wi-Fi / lwIP / web server on core 0 (the UI is on core 1)
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=768

# FAT: long UTF-8 names, 4 KB sectors (faster), safe-ish against power loss
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# console: `tasks` needs the trace facility
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_LOG_COLORS=n

