# Shared base configuration for the Tulip CC launcher and every app.
# Apps MUST build with these (same flash/PSRAM setup as the bootloader the
# launcher installed), plus their own sdkconfig.defaults on top.

# --- Tulip CC v4: ESP32-S3 N32R8 (32 MB octal flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Apps run from OTA slots; if one dies before tulip_app_init() the
# bootloader rolls back to the launcher.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- PSRAM; XIP from PSRAM keeps both cores running during flash writes
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- RTOS / drivers
CONFIG_FREERTOS_HZ=1000
CONFIG_GPTIMER_ISR_IRAM_SAFE=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
CONFIG_I2C_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- LVGL 9.2 (RGB565 render, converted to the panel's RGB332 in flush)
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL allocates from PSRAM (src/lv_mem_psram.c), keeping internal RAM free
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_TEXTAREA=y
CONFIG_LV_USE_SLIDER=y
CONFIG_LV_BUILD_EXAMPLES=n

# The RGB panel needs GDMA_ISR_IRAM_SAFE, and then every GDMA user must keep
# its interrupt context in internal RAM. Without this the I2S driver puts its
# channel object in PSRAM and i2s_channel_init_std_mode() fails with
# ESP_ERR_INVALID_ARG: no audio at all.
CONFIG_I2S_ISR_IRAM_SAFE=y

# app_main does real work at start-up (the launcher's first-start storage
# set-up, the apps' modules loading their files): 8 KB, not the default 3.5
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
